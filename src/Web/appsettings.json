{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/remsolution-.log.json",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  // What the app may do to its own database at startup. The deployment applies
  // the migration bundle; MigrateOnStartup is left unset so it defaults to
  // Development only, and the app refuses to start on a stale schema.
  // PlatformAdminPassword has no default outside Development: set it in Key
  // Vault for the first deployment, sign in, change it, remove it.
  "Database": {
    "SeedOnStartup": true,
    "FailOnPendingMigrations": true,
    "PlatformAdminEmail": "platformadmin@localhost"
  },
  // Outbound mail (password resets, client account invitations). An empty Host
  // disables sending: the app logs the message instead, which is what keeps a
  // fresh checkout runnable without a mail server. Password belongs in Key
  // Vault or user secrets, never here. PublicBaseUrl is this deployment's
  // public address, used to build the sign-in link inside the emails.
  "Email": {
    "Host": "",
    "Port": 587,
    "UseSsl": true,
    "UserName": "",
    "FromAddress": "",
    "FromName": "RemSolution",
    "PublicBaseUrl": ""
  },
  // Request throttling. The per-minute figures assume a couple of dozen staff
  // behind one office address; raise AnonymousPerMinute for an agency whose
  // whole team shares a NAT. Registration is per hour, not per minute.
  "RateLimiting": {
    "Enabled": true,
    "AnonymousPerMinute": 120,
    "AuthenticatedPerMinute": 600,
    "PublicBrowsePerMinute": 60,
    "AuthenticationPerMinute": 10,
    "RegistrationPerHour": 5
  },
  "Jwt": {
    "Issuer": "RemSolution",
    "Audience": "RemSolution",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  }
}
