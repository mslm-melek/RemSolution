@page
@model RemSolution.Web.Areas.Identity.Pages.Account.ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = L["Identity.ForgotConfirm.Title"];
    Layout = "~/Areas/Identity/Pages/Account/_AuthLayout.cshtml";
}

<p class="auth-subtitle">@L["Identity.ForgotConfirm.Subtitle"]</p>

<p class="auth-message">@L["Identity.ForgotConfirm.Message"]</p>

@if (Model.DevResetLink is not null)
{
    <div class="dev-note">
        <strong>@L["Identity.ForgotConfirm.DevOnly"]</strong> — @L["Identity.ForgotConfirm.DevHint"]
        <a href="@Model.DevResetLink">@L["Identity.ForgotConfirm.DevLink"]</a>
    </div>
}

<div class="auth-links">
    <a asp-page="./Login">@L["Identity.BackToSignIn"]</a>
</div>
