@using System.Globalization
@{
    var uiLanguage = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var textDirection = uiLanguage == Languages.Arabic ? "rtl" : "ltr";
    // Round-trips back to this exact page so switching language never loses the
    // return URL a sign-in flow was carrying.
    var currentPath = $"{Context.Request.Path}{Context.Request.QueryString}";
}
<!DOCTYPE html>
<html lang="@uiLanguage" dir="@textDirection">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RemSolution</title>
    @* Same storage key and default as the SPA (shared/theme.ts), set before the
       first paint so a dark-mode user never sees a white flash. *@
    <script>
        (function () {
            var choice = null;
            try { choice = localStorage.getItem('remsolution.theme'); } catch (e) { }
            var dark = choice === 'dark' ||
                ((!choice || choice === 'system') && window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches);
            if (dark) document.documentElement.setAttribute('data-theme', 'dark');
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Poppins:wght@500&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    @* Tokens copied from ClientApp/src/styles.scss — keep the two in step. *@
    <style>
        :root {
            color-scheme: light;
            --brand-50: #eff6ff; --brand-500: #3b82f6; --brand-600: #2563eb; --brand-700: #1d4ed8;
            --brand-800: #1e40af; --brand-900: #172554;
            --surface: #ffffff; --surface-2: #f8fafc; --line: #e2e8f0; --line-strong: #cbd5e1;
            --ink: #1e293b; --ink-2: #475569; --muted: #64748b;
            --danger: #dc2626; --danger-bg: #fee2e2; --danger-ink: #991b1b;
            --warn-bg: #fef3c7; --warn-ink: #854f0b;
            --on-accent: #ffffff; --on-accent-2: rgba(255, 255, 255, .82); --on-accent-weak: rgba(255, 255, 255, .16);
            --font-display: 'Poppins', 'Inter', system-ui, sans-serif;
            --font-body: 'Inter', system-ui, sans-serif;
            --r-sm: 6px; --r: 8px; --r-lg: 12px;
            --shadow-3: 0 12px 28px rgba(15, 23, 42, .12);
        }

        :root[data-theme='dark'] {
            color-scheme: dark;
            --brand-50: #1c2740; --brand-600: #60a5fa;
            --surface: #2a3042; --surface-2: #232838; --line: #3a4256; --line-strong: #4b5568;
            --ink: #f1f5f9; --ink-2: #cbd5e1; --muted: #94a3b8;
            --danger: #f87171; --danger-bg: #4c1d1d; --danger-ink: #fca5a5;
            --warn-bg: #422006; --warn-ink: #fcd34d;
            --shadow-3: 0 12px 28px rgba(0, 0, 0, .5);
        }

        *, *::before, *::after { box-sizing: border-box; }

        body {
            margin: 0;
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 72px 16px 40px;
            font: 400 14px/1.5 var(--font-body);
            color: var(--ink);
            -webkit-font-smoothing: antialiased;
            /* The public home's hero band, so signing in reads as the same site. */
            background:
                radial-gradient(120% 150% at 100% 0%, var(--on-accent-weak), transparent 62%),
                linear-gradient(120deg, var(--brand-900) 0%, var(--brand-800) 50%, var(--brand-700) 100%);
        }

        a { color: var(--brand-600); text-decoration: none; }
        a:hover { text-decoration: underline; }
        :focus-visible { outline: 2px solid var(--brand-500); outline-offset: 2px; }

        .material-icons { font-size: 20px; line-height: 1; }

        /* --- Top strip: the way home, and the theme ----------------------- */

        .auth-top {
            position: absolute;
            top: 16px;
            inset-inline: 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .auth-home {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            height: 36px;
            padding: 0 10px 0 6px;
            border-radius: var(--r-sm);
            color: var(--on-accent);
            font-weight: 500;
        }

        .auth-home:hover { background: var(--on-accent-weak); text-decoration: none; }
        [dir='rtl'] .auth-home .material-icons { transform: scaleX(-1); }

        .auth-theme {
            display: inline-grid;
            place-items: center;
            width: 38px;
            height: 38px;
            border: 0;
            border-radius: 50%;
            background: none;
            color: var(--on-accent);
            cursor: pointer;
        }

        .auth-theme:hover { background: var(--on-accent-weak); }

        /* --- The card ------------------------------------------------------- */

        .auth-card {
            width: 100%;
            max-width: 440px;
            padding: 2rem 2rem 1.5rem;
            background: var(--surface);
            border-radius: var(--r-lg);
            box-shadow: var(--shadow-3);
        }

        .auth-brand {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 20px;
            color: var(--ink);
            font: 500 16px var(--font-display);
        }

        .auth-brand:hover { text-decoration: none; }

        .mark {
            display: grid;
            place-items: center;
            width: 30px;
            height: 30px;
            border-radius: var(--r);
            background: linear-gradient(140deg, var(--brand-500), var(--brand-800));
            color: var(--on-accent);
            font: 500 15px var(--font-display);
        }

        .auth-card h1 {
            margin: 0;
            font: 500 22px/1.25 var(--font-display);
        }

        .auth-subtitle {
            margin: 4px 0 20px;
            color: var(--muted);
            font-size: 13px;
        }

        form { display: flex; flex-direction: column; gap: 12px; }

        /* --- Fields: the label sits inside the box, as on the public search - */

        .form-group { display: flex; flex-direction: column; gap: 4px; }

        .field {
            display: flex;
            flex-direction: column;
            justify-content: center;
            min-height: 52px;
            padding: 4px 12px;
            border: 1px solid var(--line);
            border-radius: var(--r-sm);
            background: var(--surface);
            cursor: text;
        }

        .field:hover { border-color: var(--line-strong); }
        .field:focus-within { border-color: var(--brand-500); box-shadow: 0 0 0 1px var(--brand-500); }
        .field:has(.input-validation-error) { border-color: var(--danger); box-shadow: 0 0 0 1px var(--danger); }

        .field label {
            font-size: 11px;
            font-weight: 500;
            color: var(--muted);
            cursor: text;
        }

        .field input {
            width: 100%;
            min-width: 0;
            padding: 2px 0;
            border: 0;
            outline: none;
            background: transparent;
            color: var(--ink);
            font: 400 14px var(--font-body);
        }

        .field input::placeholder { color: var(--muted); opacity: .7; }

        .check {
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--ink-2);
            font-size: 13px;
        }

        .check input { width: 16px; height: 16px; margin: 0; accent-color: var(--brand-500); }

        .btn-primary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            min-height: 46px;
            margin-top: 4px;
            border: 0;
            border-radius: var(--r-sm);
            background: var(--brand-500);
            color: var(--on-accent);
            font: 500 15px var(--font-body);
            cursor: pointer;
        }

        .btn-primary:hover { background: var(--brand-700); }

        .auth-links {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            margin-top: 20px;
            padding-top: 16px;
            border-top: 1px solid var(--line);
            color: var(--ink-2);
            font-size: 13px;
            text-align: center;
        }

        .auth-links a { font-weight: 500; }

        /* --- Messages ------------------------------------------------------- */

        .field-validation-error { color: var(--danger-ink); font-size: 12px; }
        .field-validation-valid { display: none; }

        .validation-summary-errors {
            padding: 10px 14px;
            border-radius: var(--r);
            background: var(--danger-bg);
            color: var(--danger-ink);
            font-size: 13px;
        }

        .validation-summary-errors ul { margin: 0; padding: 0; list-style: none; }
        .validation-summary-valid { display: none; }

        .auth-message { margin: 0; color: var(--ink-2); font-size: 14px; line-height: 1.6; }

        .dev-note {
            margin-top: 16px;
            padding: 10px 14px;
            border-radius: var(--r);
            background: var(--warn-bg);
            color: var(--warn-ink);
            font-size: 13px;
            word-break: break-all;
        }

        /* --- Language ------------------------------------------------------- */

        .lang-switch {
            display: flex;
            justify-content: center;
            gap: 4px;
            margin-top: 16px;
            font-size: 12px;
        }

        .lang-switch a {
            padding: 4px 10px;
            border-radius: var(--r-sm);
            color: var(--muted);
        }

        .lang-switch a:hover { background: var(--surface-2); text-decoration: none; }
        .lang-switch a.current { background: var(--brand-50); color: var(--brand-600); font-weight: 500; }

        @@media (max-width: 480px) {
            .auth-card { padding: 1.5rem 1.25rem 1.25rem; }
        }
    </style>
</head>
<body>
    <div class="auth-top">
        <a class="auth-home" href="/" aria-label="@L["Identity.BackToHome"]" title="@L["Identity.BackToHome"]">
            <span class="material-icons" aria-hidden="true">arrow_back</span>RemSolution
        </a>
        <button type="button" class="auth-theme" id="themeToggle"
                aria-label="@L["Identity.ToggleTheme"]" title="@L["Identity.ToggleTheme"]">
            <span class="material-icons" aria-hidden="true" id="themeIcon">dark_mode</span>
        </button>
    </div>

    <main class="auth-card">
        <a class="auth-brand" href="/"><span class="mark" aria-hidden="true">R</span>RemSolution</a>
        <h1>@ViewData["Title"]</h1>
        @RenderBody()

        @* Anonymous visitors have no account to store a preference on, so the
           switch just sets the culture cookie and re-renders this page. *@
        <nav class="lang-switch">
            @foreach (var language in Languages.All)
            {
                <a class="@(language == uiLanguage ? "current" : null)"
                   href="/culture/set?language=@language&returnUrl=@Uri.EscapeDataString(currentPath)">
                    @L["Language.Name." + language]
                </a>
            }
        </nav>
    </main>

    <script>
        (function () {
            var html = document.documentElement;
            var icon = document.getElementById('themeIcon');
            // The icon shows what you would GET, like the SPA's toggle.
            function paint() { icon.textContent = html.getAttribute('data-theme') === 'dark' ? 'light_mode' : 'dark_mode'; }
            paint();
            document.getElementById('themeToggle').addEventListener('click', function () {
                var dark = html.getAttribute('data-theme') !== 'dark';
                if (dark) html.setAttribute('data-theme', 'dark'); else html.removeAttribute('data-theme');
                try { localStorage.setItem('remsolution.theme', dark ? 'dark' : 'light'); } catch (e) { }
                paint();
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
