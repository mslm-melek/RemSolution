@page
@model RemSolution.Web.Areas.Identity.Pages.Account.ResetPasswordConfirmationModel
@{
    ViewData["Title"] = L["Identity.ResetConfirm.Title"];
    Layout = "~/Areas/Identity/Pages/Account/_AuthLayout.cshtml";
}

<p class="auth-subtitle">@L["Identity.ResetConfirm.Subtitle"]</p>

<p class="auth-message">@L["Identity.ResetConfirm.Message"]</p>

<div class="auth-links">
    <a asp-page="./Login">@L["Identity.ResetConfirm.GoToSignIn"]</a>
</div>
