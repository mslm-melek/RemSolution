@page
@model RemSolution.Web.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = L["Identity.Forgot.Title"];
    Layout = "~/Areas/Identity/Pages/Account/_AuthLayout.cshtml";
}

<p class="auth-subtitle">@L["Identity.Forgot.Subtitle"]</p>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

    <div class="form-group">
        <label asp-for="Input.Email">@L["Identity.Field.Email"]</label>
        <input asp-for="Input.Email" autocomplete="username" autofocus placeholder="you@example.com" />
        <span asp-validation-for="Input.Email" class="field-validation-error"></span>
    </div>

    <button type="submit" class="btn-primary">@L["Identity.Forgot.Submit"]</button>

    <div class="auth-links">
        <a asp-page="./Login">@L["Identity.BackToSignIn"]</a>
    </div>
</form>

@section Scripts {
    <script src="~/Identity/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/Identity/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/Identity/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}
