@page
@model RemSolution.Web.Areas.Identity.Pages.Account.Manage.IndexModel
@{
    ViewData["Title"] = L["Identity.Manage.Profile"];
    ViewData["ActivePage"] = "Index";
    Layout = "~/Areas/Identity/Pages/Account/Manage/_ManageLayout.cshtml";
}

@if (Model.StatusMessage is not null)
{
    <div class="status-message">@Model.StatusMessage</div>
}

<form method="post">
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

    <div class="form-group">
        <label>@L["Identity.Field.Email"]</label>
        <input type="email" value="@Model.Email" readonly />
        <div class="field-hint">@L["Identity.Manage.EmailReadonlyHint"]</div>
    </div>

    <div class="form-group">
        <label asp-for="Input.FullName">@L["Identity.Field.FullName"]</label>
        <input asp-for="Input.FullName" placeholder="John Doe" />
        <span asp-validation-for="Input.FullName" class="field-validation-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Input.PhoneNumber">@L["Identity.Field.PhoneNumber"]</label>
        <input asp-for="Input.PhoneNumber" type="tel" placeholder="+216 ..." />
        <span asp-validation-for="Input.PhoneNumber" class="field-validation-error"></span>
    </div>

    <div class="form-group">
        <label for="language">@L["Identity.Language"]</label>
        @* Anonymous pages switch language through /culture/set; here the user is
           signed in, so the choice is persisted on the account and the page
           re-renders in it. *@
        <select id="language" asp-for="Input.PreferredLanguage">
            @foreach (var language in Languages.All)
            {
                <option value="@language">@L["Language.Name." + language]</option>
            }
        </select>
    </div>

    <button type="submit" class="btn-primary">@L["Identity.Manage.Save"]</button>
</form>

@section Scripts {
    <script src="~/Identity/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/Identity/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/Identity/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}
